#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA13.commandment_subtitles[1]
msgid "DA13a: We are not to associate with people who would deceive us."
msgstr "DA13a: We mogen niet omgaan met mensen die ons willen misleiden."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA13.commandment_subtitles[2]
msgid "DA13b: We are not to associate with people who would lead us astray."
msgstr ""
"DA13b: We mogen niet omgaan met mensen die ons op een dwaalspoor kunnen "
"brengen."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA18.commandment_subtitles[1]
msgid "DA18a: We are not to cause our neighbor to stumble."
msgstr "DA18a: Wij mogen onze naaste niet laten struikelen."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA18.commandment_subtitles[2]
msgid "DA18b: We are not to cause our brother to stumble."
msgstr "DA18b: Wij mogen onze broeder niet laten struikelen."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA22.commandment_subtitles[1]
msgid "DA22a: We are not to rob our neighbors."
msgstr "DA22a: We mogen onze buren niet beroven."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA22.commandment_subtitles[2]
msgid "DA22b: We are not to steal from our neighbors.."
msgstr "DA22b: We mogen niet stelen van onze buren.."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA24.commandment_subtitles[1]
msgid "DA24a: We are to love our brother."
msgstr "DA24a: We moeten onze broeder liefhebben."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA24.commandment_subtitles[2]
msgid "DA24b: We are to love our neighbor"
msgstr "DA24b: We moeten onze naaste liefhebben"

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA26.commandment_subtitles[1]
msgid "DA26a: We are not to quarrel with our neighbor."
msgstr "DA26a: We mogen geen ruzie maken met onze buurman."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA26.commandment_subtitles[2]
msgid "DA26b: We are not to fight with our neighbor."
msgstr "DA26b: We mogen niet vechten met onze buurman."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA29.commandment_subtitles[1]
msgid "DA29a: We are to be merciful."
msgstr "DA29a: We moeten barmhartig zijn."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA29.commandment_subtitles[2]
msgid "DA29d: We are not to be heartless."
msgstr "DA29d: We moeten niet harteloos zijn."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA29.commandment_subtitles[3]
msgid "DA29e: We are not to be ruthless."
msgstr "DA29e: We mogen niet meedogenloos zijn."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA40.commandment_subtitles[1]
msgid "DA40a: We are to welcome people who are weak in faith."
msgstr "DA40a: We moeten mensen verwelkomen die zwak zijn in het geloof."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA40.commandment_subtitles[2]
msgid "DA40b: We are not to argue with people who are weak in faith."
msgstr "DA40b: We mogen geen ruzie maken met mensen die zwak in geloof zijn."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA41.commandment_subtitles[1]
msgid "DA41a: We are be friends with brothers."
msgstr "DA41a: We zijn vrienden met broers."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA41.commandment_subtitles[2]
msgid "DA41b: We are to be friendly to our outsiders."
msgstr "DA41b: We moeten vriendelijk zijn tegen onze buitenstaanders."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA42.commandment_subtitles[1]
msgid "DA42a: We are not to engage in fruitless controversies."
msgstr "DA42a: We mogen ons niet inlaten met vruchteloze controverses."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA42.commandment_subtitles[2]
msgid "DA42b: We are not to engage in stupid discussions."
msgstr "DA42b: We mogen geen domme discussies voeren."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA45.commandment_subtitles[1]
msgid "DA45a: We are not to sin against our brother."
msgstr "DA45a: We mogen niet zondigen tegen onze broeder."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA45.commandment_subtitles[2]
msgid "DA45b: We are not to sin against our neighbor.."
msgstr "DA45b: We mogen niet zondigen tegen onze naaste.."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA48.commandment_subtitles[1]
msgid "DA48a: We are not to harbor bitterness against our neighbor."
msgstr "DA48a: We mogen geen bitterheid koesteren tegenover onze buurman."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA48.commandment_subtitles[2]
msgid "DA48b: We are not to harbor malice against our neighbor."
msgstr "DA48b: We mogen geen kwaadaardigheid jegens onze buurman koesteren."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA48.commandment_subtitles[3]
msgid "DA48c: We are not to harbor meanness against our neighbor."
msgstr "DA48c: We mogen geen gemeenheid koesteren tegen onze buurman."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA48.commandment_subtitles[4]
msgid "DA48d: We are not to harbor spitefulness against our neighbor."
msgstr "DA48d: We mogen geen wrok jegens onze naaste koesteren."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA50.commandment_subtitles[1]
msgid "DA50a: We are to bear with one another in love."
msgstr "DA50a: We moeten elkaar in liefde verdragen."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA50.commandment_subtitles[2]
msgid "DA50b: We are to bear with one another with forgiveness."
msgstr "DA50b: We moeten elkaar vergevensgezind verdragen."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA59.commandment_subtitles[1]
msgid "DA59a: We are not to mislead a child."
msgstr "DA59a: We mogen een kind niet misleiden."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA59.commandment_subtitles[2]
msgid "DA59b: We are not to harm a child."
msgstr "DA59b: We mogen een kind geen kwaad doen."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA60.commandment_subtitles[1]
msgid ""
"DA60a: We are to treat people with respect in ways appropriate to their age."
msgstr ""
"DA60a: We moeten mensen met respect behandelen op een manier die past bij "
"hun leeftijd."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA60.commandment_subtitles[2]
msgid ""
"DA60b: We are to treat people with respect in ways appropriate to their "
"gender."
msgstr ""
"DA60b: We moeten mensen met respect behandelen op een manier die past bij "
"hun geslacht."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA61.commandment_subtitles[1]
msgid "DA61a: We are to exhort one another to love."
msgstr "DA61a: We moeten elkaar aansporen tot liefde."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA61.commandment_subtitles[2]
msgid "DA61b: We are to exhort one another to good deeds."
msgstr "DA61b: We moeten elkaar aansporen tot goede daden."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA64.commandment_subtitles[1]
msgid "DA64a: We are not to speak badly or critically of our brother."
msgstr "DA64a: We mogen niet slecht of kritisch over onze broeder spreken."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA64.commandment_subtitles[2]
msgid "DA64b: We are not to speak badly or critically of our neighbor.."
msgstr "DA64b: We mogen niet slecht of kritisch over onze buurman spreken."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA68.commandment_subtitles[1]
msgid "DA68a: We are to be welcoming to our brother."
msgstr "DA68a: We moeten onze broeder verwelkomen."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA68.commandment_subtitles[2]
msgid "DA68b: We are to be welcoming to our neighbor."
msgstr "DA68b: We moeten onze buurman verwelkomen."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA68.commandment_subtitles[3]
msgid "DA68c: We are to be hospitable to our brother."
msgstr "DA68c: We moeten gastvrij zijn voor onze broeder."

#: data/lawofmessiah/Law_of_Messiah_nt.yaml:DA68.commandment_subtitles[4]
msgid "DA68d: We are to be hospitable to our neighbor."
msgstr "DA68d: We moeten gastvrij zijn tegenover onze naaste."

